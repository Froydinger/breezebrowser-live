{
  "manifest_version": 2,
  "name": "Breeze page controls",
  "version": "1.0.0",
  "description": "Applies page controls selected by the user in Breeze.",
  "browser_specific_settings": {
    "gecko": {
      "id": "breeze-page-controls@froydinger.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
